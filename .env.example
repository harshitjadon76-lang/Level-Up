# Supabase (Project Settings > API). The publishable/anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase admin key. Used only by server routes for protected Google tokens.
# Never prefix this variable with NEXT_PUBLIC_ or expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (same one set in Supabase > Authentication > Google). SERVER ONLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini (aistudio.google.com/apikey). SERVER ONLY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Web Push (generate with: npx web-push generate-vapid-keys)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:you@example.com

# Secret used to protect the scheduled push dispatcher. Generate a long random value.
CRON_SECRET=
